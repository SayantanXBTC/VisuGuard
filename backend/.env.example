SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
MAX_PAGES=10
# Optional AI visual analysis (a vision model explains what changed on each changed page).
# Leave AI_API_KEY empty to run VisuGuard without it. Never put this key in the frontend.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Edith, the in-app chat assistant (Google Gemini). Leave empty to show Edith as not set up.
# Never put this key in the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
