SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001
MAX_PAGES=10
# AI features, both powered by Anthropic Claude through the same key. Leave AI_API_KEY empty
# to run VisuGuard without either. Never put this key in the frontend.
AI_API_KEY=
# Vision model for AI visual analysis (explains what changed on each changed page).
AI_MODEL=claude-sonnet-5
# Chat model for Edith, the in-app assistant.
EDITH_MODEL=claude-haiku-4-5-20251001
